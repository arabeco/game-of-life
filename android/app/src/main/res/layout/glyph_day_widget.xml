<?xml version="1.0" encoding="utf-8"?>
<!--
  O WIDGET DO DIA (13/10/2026): vitrine, nao controle remoto.
  Duas abas desenhadas como imagem (GlyphDayPaint): RESUMO e PLANNER.
  Tocar em qualquer lugar abre o planner no app; as abas so trocam a tela.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/glyph_day_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/glyph_day_widget_background"
    android:orientation="vertical"
    android:padding="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="20dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/glyph_day_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:letterSpacing="0.18"
            android:maxLines="1"
            android:text="MEU DIA"
            android:textColor="#F1D595"
            android:textSize="10sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/glyph_day_tab_resumo"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center"
            android:letterSpacing="0.14"
            android:paddingLeft="8dp"
            android:paddingRight="8dp"
            android:text="RESUMO"
            android:textColor="#8E8878"
            android:textSize="8sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/glyph_day_tab_planner"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center"
            android:letterSpacing="0.14"
            android:paddingLeft="8dp"
            android:paddingRight="4dp"
            android:text="PLANNER"
            android:textColor="#F1D595"
            android:textSize="8sp"
            android:textStyle="bold" />
    </LinearLayout>

    <ImageView
        android:id="@+id/glyph_day_body"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="4dp"
        android:layout_weight="1"
        android:contentDescription="Meu dia no Glyph"
        android:scaleType="fitXY" />

    <TextView
        android:id="@+id/glyph_day_footer"
        android:layout_width="match_parent"
        android:layout_height="12dp"
        android:layout_marginTop="3dp"
        android:ellipsize="end"
        android:gravity="end|center_vertical"
        android:letterSpacing="0.12"
        android:maxLines="1"
        android:text="ABRA O GLYPH PARA SINCRONIZAR"
        android:textColor="#7F7868"
        android:textSize="7sp" />
</LinearLayout>
