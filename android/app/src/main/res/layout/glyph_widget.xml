<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/glyph_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/glyph_cycle_widget_background"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:paddingLeft="14dp"
    android:paddingTop="8dp"
    android:paddingRight="14dp"
    android:paddingBottom="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/glyph_widget_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:fontFamily="sans"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="GLYPH"
            android:textAllCaps="true"
            android:textColor="#F7F3E9"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/glyph_widget_end_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:text="ABRIR"
            android:textAllCaps="true"
            android:textColor="#CFC6AD"
            android:textSize="8sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/glyph_widget_subtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:ellipsize="end"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:text="Dia 1/30"
        android:textColor="#C7D1DF"
        android:textSize="10sp" />

    <TextView
        android:id="@+id/glyph_widget_meta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:ellipsize="end"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:text="Ciclo ativo"
        android:textAllCaps="true"
        android:textColor="#A8B6C9"
        android:textSize="7sp"
        android:textStyle="bold" />

    <LinearLayout
        android:id="@+id/glyph_widget_actions_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="7dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/glyph_widget_actions_label"
            android:layout_width="68dp"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="0/0"
            android:textColor="#C7D1DF"
            android:textSize="9sp"
            android:textStyle="bold" />

        <ProgressBar
            android:id="@+id/glyph_widget_actions_bar"
            style="@android:style/Widget.ProgressBar.Horizontal"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:max="100"
            android:minHeight="4dp"
            android:progress="0"
            android:progressDrawable="@drawable/glyph_widget_progress" />

        <TextView
            android:id="@+id/glyph_widget_actions_percent"
            android:layout_width="42dp"
            android:layout_height="wrap_content"
            android:gravity="right"
            android:includeFontPadding="false"
            android:text="0%"
            android:textColor="#F7F3E9"
            android:textSize="9sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/glyph_widget_time_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/glyph_widget_time_label"
            android:layout_width="68dp"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="Tempo"
            android:textColor="#A8B6C9"
            android:textSize="9sp"
            android:textStyle="bold" />

        <ProgressBar
            android:id="@+id/glyph_widget_time_bar"
            style="@android:style/Widget.ProgressBar.Horizontal"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:max="100"
            android:minHeight="4dp"
            android:progress="0"
            android:progressDrawable="@drawable/glyph_widget_progress_soft" />

        <TextView
            android:id="@+id/glyph_widget_time_percent"
            android:layout_width="42dp"
            android:layout_height="wrap_content"
            android:gravity="right"
            android:includeFontPadding="false"
            android:text="0%"
            android:textColor="#E8E3D6"
            android:textSize="9sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
