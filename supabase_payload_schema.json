{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ProfileAttributes",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "gratitude": {
      "type": "object",
      "required": ["level", "motto_main", "beliefs_list", "flow_state_analysis"],
      "properties": {
        "level": { "type": "integer", "minimum": 1, "maximum": 10 },
        "motto_main": { "$ref": "#/definitions/slotType1" },
        "beliefs_list": { "$ref": "#/definitions/slotType1" },
        "flow_state_analysis": { "$ref": "#/definitions/slotType1" }
      }
    },
    "spirit": {
      "type": "object",
      "required": ["level", "belief_system", "entity_leader", "entity_protector"],
      "properties": {
        "level": { "type": "integer", "minimum": 1, "maximum": 10 },
        "belief_system": { "$ref": "#/definitions/slotType1" },
        "entity_leader": { "$ref": "#/definitions/slotType3" },
        "entity_protector": { "$ref": "#/definitions/slotType3" }
      }
    },
    "mental": {
      "type": "object",
      "required": ["level", "operational_philosophy", "mental_status", "vulnerability_desc"],
      "properties": {
        "level": { "type": "integer", "minimum": 1, "maximum": 10 },
        "operational_philosophy": { "$ref": "#/definitions/slotType1" },
        "mental_status": { "$ref": "#/definitions/slotType5" },
        "vulnerability_desc": { "$ref": "#/definitions/slotType1" }
      }
    },
    "truth": {
      "type": "object",
      "required": ["level", "mtp_mission", "passive_traits", "mbti_type", "zodiac_sign", "inspiration_slots"],
      "properties": {
        "level": { "type": "integer", "minimum": 1, "maximum": 10 },
        "mtp_mission": { "$ref": "#/definitions/slotType1" },
        "passive_traits": { "$ref": "#/definitions/slotType5" },
        "mbti_type": { "$ref": "#/definitions/slotType1" },
        "zodiac_sign": { "$ref": "#/definitions/slotType1" },
        "inspiration_slots": {
          "type": "array",
          "items": { "$ref": "#/definitions/slotType3" }
        }
      }
    },
    "inspiration": {
      "type": "object",
      "required": ["level", "projects_list"],
      "properties": {
        "level": { "type": "integer", "minimum": 1, "maximum": 10 },
        "projects_list": {
          "type": "array",
          "items": { "$ref": "#/definitions/slotType3" }
        }
      }
    },
    "love": {
      "type": "object",
      "required": ["level", "social_role_analysis", "inner_circle", "war_brothers"],
      "properties": {
        "level": { "type": "integer", "minimum": 1, "maximum": 10 },
        "social_role_analysis": { "$ref": "#/definitions/slotType1" },
        "inner_circle": {
          "type": "array",
          "items": { "$ref": "#/definitions/slotType4" }
        },
        "war_brothers": {
          "type": "array",
          "items": { "$ref": "#/definitions/slotType4" }
        }
      }
    },
    "abundance": {
      "type": "object",
      "required": ["level", "burn_rate_indicator", "liquidity_sources", "assets_slots"],
      "properties": {
        "level": { "type": "integer", "minimum": 1, "maximum": 10 },
        "burn_rate_indicator": { "$ref": "#/definitions/slotType1" },
        "liquidity_sources": { "$ref": "#/definitions/slotType1" },
        "assets_slots": {
          "type": "array",
          "items": { "$ref": "#/definitions/slotType3" }
        }
      }
    },
    "work": {
      "type": "object",
      "required": ["level", "primary_class", "secondary_class", "career_history"],
      "properties": {
        "level": { "type": "integer", "minimum": 1, "maximum": 10 },
        "primary_class": { "$ref": "#/definitions/slotType2" },
        "secondary_class": { "$ref": "#/definitions/slotType2" },
        "career_history": { "$ref": "#/definitions/slotType1" }
      }
    },
    "authenticity": {
      "type": "object",
      "required": ["level", "hobbies_slots"],
      "properties": {
        "level": { "type": "integer", "minimum": 1, "maximum": 10 },
        "hobbies_slots": {
          "type": "array",
          "items": { "$ref": "#/definitions/slotType3" }
        }
      }
    },
    "physical": {
      "type": "object",
      "required": ["level", "shape_photo", "physical_status", "attributes_stats"],
      "properties": {
        "level": { "type": "integer", "minimum": 1, "maximum": 10 },
        "shape_photo": { "$ref": "#/definitions/slotType4" },
        "physical_status": { "$ref": "#/definitions/slotType5" },
        "attributes_stats": {
          "type": "array",
          "items": { "$ref": "#/definitions/slotType2" }
        }
      }
    },
    "player_data": {
      "$ref": "#/definitions/playerData"
    }
  },
  "required": [
    "gratitude",
    "spirit",
    "mental",
    "truth",
    "inspiration",
    "love",
    "abundance",
    "work",
    "authenticity",
    "physical"
  ],
  "definitions": {
    "playerData": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "version": { "type": "integer" },
        "assets": { "type": "object", "additionalProperties": true },
        "arenas": { "type": "array", "items": { "type": "object" } },
        "planner": { "type": "object", "additionalProperties": true },
        "profile": { "type": "object", "additionalProperties": true },
        "config": { "type": "object", "additionalProperties": true }
      }
    },
    "slotType1": {
      "type": "object",
      "required": ["type", "title", "value"],
      "properties": {
        "type": { "const": "type1" },
        "title": { "type": "string" },
        "value": { "type": "string" }
      }
    },
    "slotType2": {
      "type": "object",
      "required": ["type", "title", "value", "sub_value"],
      "properties": {
        "type": { "const": "type2" },
        "title": { "type": "string" },
        "value": { "type": "string" },
        "sub_value": { "type": "string" }
      }
    },
    "slotType3": {
      "type": "object",
      "required": ["type", "title", "image_url", "caption"],
      "properties": {
        "type": { "const": "type3" },
        "title": { "type": "string" },
        "image_url": { "type": "string" },
        "caption": { "type": "string" }
      }
    },
    "slotType4": {
      "type": "object",
      "required": ["type", "top_label", "image_url", "caption"],
      "properties": {
        "type": { "const": "type4" },
        "top_label": { "type": "string" },
        "image_url": { "type": "string" },
        "caption": { "type": "string" }
      }
    },
    "slotType5": {
      "type": "object",
      "required": ["type", "title", "current_value", "options_list"],
      "properties": {
        "type": { "const": "type5" },
        "title": { "type": "string" },
        "current_value": { "type": ["string", "number"] },
        "options_list": {
          "type": "array",
          "items": { "type": ["string", "number"] }
        }
      }
    }
  }
}
