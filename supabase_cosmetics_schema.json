{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ProfileCosmetics",
  "type": "object",
  "additionalProperties": false,
  "required": ["banner_id", "frame_id", "color_theme", "active_effects"],
  "properties": {
    "banner_id": { "type": "string", "minLength": 1 },
    "frame_id": { "type": "string", "minLength": 1 },
    "color_theme": { "type": "string", "minLength": 1 },
    "active_effects": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}
