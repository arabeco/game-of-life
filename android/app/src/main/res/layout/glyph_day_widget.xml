<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/glyph_day_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/glyph_widget_background"
    android:orientation="vertical"
    android:paddingLeft="16dp"
    android:paddingTop="14dp"
    android:paddingRight="16dp"
    android:paddingBottom="14dp">

    <TextView
        android:id="@+id/glyph_day_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:text="RESUMO DO DIA"
        android:textAllCaps="true"
        android:textColor="#F2E7C4"
        android:textSize="13sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/glyph_day_subtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:ellipsize="end"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:text="Hoje"
        android:textColor="#B8B0A0"
        android:textSize="11sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/glyph_day_done"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/glyph_widget_pill_gold"
            android:ellipsize="end"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:paddingLeft="8dp"
            android:paddingTop="6dp"
            android:paddingRight="8dp"
            android:paddingBottom="6dp"
            android:text="0 feitas"
            android:textAlignment="center"
            android:textColor="#F6D65B"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/glyph_day_planned"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="7dp"
            android:layout_weight="1"
            android:background="@drawable/glyph_widget_pill_dark"
            android:ellipsize="end"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:paddingLeft="8dp"
            android:paddingTop="6dp"
            android:paddingRight="8dp"
            android:paddingBottom="6dp"
            android:text="0 programadas"
            android:textAlignment="center"
            android:textColor="#D8D0BE"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/glyph_day_stock"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="0 estoque"
            android:textColor="#AFA695"
            android:textSize="10sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/glyph_day_checklist"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:gravity="right"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="0/0 checklist"
            android:textColor="#AFA695"
            android:textSize="10sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/glyph_day_focus"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1"
        android:ellipsize="end"
        android:gravity="bottom"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:text="Arena foco"
        android:textColor="#8D8574"
        android:textSize="10sp" />

    <ProgressBar
        android:id="@+id/glyph_day_progress_bar"
        style="@android:style/Widget.ProgressBar.Horizontal"
        android:layout_width="match_parent"
        android:layout_height="5dp"
        android:layout_marginTop="8dp"
        android:max="100"
        android:progress="0"
        android:progressDrawable="@drawable/glyph_widget_progress" />
</LinearLayout>
