<?xml version="1.0" encoding="utf-8"?>
<!-- O estilo novo do Painel Diario: escuro, filete dourado, canto quase reto
     (o Android 12+ arredonda pelo sistema de qualquer jeito). -->
<shape xmlns:android="http://schemas.android.com/apk/res/android">
    <gradient
        android:angle="290"
        android:endColor="#08090B"
        android:centerColor="#0D0E11"
        android:startColor="#1A1712"
        android:type="linear" />
    <corners android:radius="6dp" />
    <stroke
        android:width="1dp"
        android:color="#66B89252" />
</shape>
