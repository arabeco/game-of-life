{
    "compilerOptions":  {
                            "target":  "ES2022",
                            "experimentalDecorators":  true,
                            "useDefineForClassFields":  false,
                            "module":  "ESNext",
                            "lib":  [
                                        "ES2022",
                                        "DOM",
                                        "DOM.Iterable"
                                    ],
                            "skipLibCheck":  true,
                            "types":  [
                                          "node",
                                          "vite/client"
                                      ],
                            "moduleResolution":  "bundler",
                            "isolatedModules":  true,
                            "moduleDetection":  "force",
                            "allowJs":  true,
                            "jsx":  "react-jsx",
                            "paths":  {
                                          "@/*":  [
                                                      "./*"
                                                  ]
                                      },
                            "allowImportingTsExtensions":  true,
                            "noEmit":  true
                        },
    "include":  [
                    "*.ts",
                    "*.tsx",
                    "components/**/*.ts",
                    "components/**/*.tsx",
                    "constants/**/*.ts",
                    "constants/**/*.tsx",
                    "contexts/**/*.ts",
                    "contexts/**/*.tsx",
                    "hooks/**/*.ts",
                    "hooks/**/*.tsx",
                    "services/**/*.ts",
                    "services/**/*.tsx",
                    "utils/**/*.ts",
                    "utils/**/*.tsx",
                    "views/**/*.ts",
                    "views/**/*.tsx"
                ],
    "exclude":  [
                    "dist",
                    "public",
                    "supabase/functions",
                    "api_checkout_nextjs_sample.ts",
                    "contexts/GameContext_utf8.tsx",
                    "temp_sephirotfog_original.tsx",
                    "ActionModal.head.tsx",
                    "tmp_ActionModal_HEAD.tsx"
                ]
}
